<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="WiseBooksPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.mycompany.wisebooks.entity.Usuario</class>
        <class>com.mycompany.wisebooks.entity.Editorial</class>
        <class>com.mycompany.wisebooks.entity.Autor</class>
        <class>com.mycompany.wisebooks.entity.Categoria</class>
        <class>com.mycompany.wisebooks.entity.Genero</class>
        <class>com.mycompany.wisebooks.entity.Libro</class>
        <class>com.mycompany.wisebooks.entity.Proveedor</class>
        <class>com.mycompany.wisebooks.entity.Reserva</class>
        <class>com.mycompany.wisebooks.entity.Prestamo</class>
        <class>com.mycompany.wisebooks.entity.Sancion</class>
        <class>com.mycompany.wisebooks.entity.CopiaSeguridad</class>
        <class>com.mycompany.wisebooks.entity.Auditoria</class>
        
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mariadb://localhost:3306/wisebooks"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="org.mariadb.jdbc.Driver"/>
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>